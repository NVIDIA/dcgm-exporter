        "field_support.go",
        "ginkgo_report.go",
        "images.go",
        "k8s.go",
        "nvml_injection.go",
        "output.go",
        "registry.go",
        "selectors.go",
        "suites.go",
        "tests.go",
    ],
    importpath = "github.com/NVIDIA/dcgm-exporter/internal/e2e/cli",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/e2e/bootstrap",
        "//internal/e2e/capability",
        "//internal/e2e/clioutput",
        "//internal/e2e/cluster",

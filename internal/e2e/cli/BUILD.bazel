load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cli",
    srcs = [
        "app.go",
        "bootstrap_config.go",
        "cluster.go",
        "cluster_lifecycle.go",
        "dcgm_fields.go",
        "dry_run.go",
        "env.go",

    embed = [":cli"],
    deps = [
        "//internal/e2e/capability",
        "//internal/e2e/clioutput",
        "//internal/e2e/cluster",
        "//internal/e2e/config",
        "//internal/e2e/exec",
        "//internal/e2e/marker",
        "//internal/e2e/mig",

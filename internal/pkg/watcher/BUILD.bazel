load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "watcher",
    srcs = [
        "file.go",
        "gpu.go",
        "restartable_gpu.go",
        "watcher.go",
    ],
    importpath = "github.com/NVIDIA/dcgm-exporter/internal/pkg/watcher",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/pkg/dcgmprovider",
        "@com_github_fsnotify_fsnotify//:fsnotify",
        "@com_github_nvidia_go_dcgm//pkg/dcgm",

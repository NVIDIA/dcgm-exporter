    srcs = [
        "file_test.go",
        "gpu_test.go",
        "restartable_gpu_test.go",
    ],
    embed = [":watcher"],
    deps = [
        "//internal/mocks/pkg/dcgmprovider",
        "//internal/pkg/dcgmprovider",
        "@com_github_fsnotify_fsnotify//:fsnotify",
        "@com_github_nvidia_go_dcgm//pkg/dcgm",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_uber_go_mock//gomock",
    ],
)

load("@rules_go//go:def.bzl", "go_test")

config_setting(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

go_test(
    name = "static_test",
    srcs = [
        "chart_arguments_rendering_test.go",
        "chart_config_read_test.go",
        "chart_config_rendering_test.go",
        "chart_config_settings_rendering_test.go",
        "chart_dump_rendering_test.go",
        "chart_mounts_rendering_test.go",
        "chart_naming_rendering_test.go",
        "chart_networkpolicy_rendering_test.go",
        "chart_paths_test.go",
        "chart_pod_settings_rendering_test.go",
        "chart_rbac_rendering_test.go",
        "chart_scheduling_rendering_test.go",
        "chart_web_config_rendering_test.go",
        "docker_default_config_test.go",
        "grafana_dashboard_test.go",
        "host_dependency_guard_test.go",
        "latest_value_batching_fixture_test.go",
        "package_systemd_unit_test.go",
        "paths_test.go",
        "readme_contract_test.go",
        "readme_values_test.go",
        "watch_groups_selection_test.go",
    ],
    data = select({
        ":linux_amd64": [
            "@main___download_0_linux_amd64//:bin/go",
            "@main___download_0_linux_amd64//:files",
        ],
        ":linux_arm64": [
            "@main___download_0_linux_arm64//:bin/go",
            "@main___download_0_linux_arm64//:files",
        ],
    }) + [
        "//:go_module_files",
        "//:static_testdata",
        "//tests/host:source_files",
        "//tests/internal/dcgmprobe:source_files",
        "//tests/internal/metriccontract:source_files",
        "//tests/internal/nvidiasmi:source_files",
        "//tests/internal/nvmlinjection:source_files",
        "//tests/internal/nvsdmmock:source_files",
        "//tests/internal/resultmarker:source_files",
    ] + glob(["testdata/**"]),
    env = select({
        ":linux_amd64": {
            "DCGM_EXPORTER_GO_RLOCATION": "$(rlocationpath @main___download_0_linux_amd64//:bin/go)",
        },
        ":linux_arm64": {
            "DCGM_EXPORTER_GO_RLOCATION": "$(rlocationpath @main___download_0_linux_arm64//:bin/go)",
        },
    }),
    # The nested go list reads the caller's declared module cache, so this test
    # must execute on the Bazel client rather than a remote worker.
    tags = [
        "no-remote",
        "no-sandbox",
    ],
    deps = [
        "//internal/e2e/scenario",
        "//internal/pkg/appconfig",
        "//tests/internal/metriccontract",
        "@com_github_prometheus_client_model//go",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@io_k8s_api//apps/v1:apps",
        "@io_k8s_api//networking/v1:networking",
        "@io_k8s_apimachinery//pkg/apis/meta/v1/unstructured",
        "@io_k8s_apimachinery//pkg/util/strategicpatch",
        "@io_k8s_sigs_yaml//:yaml",
        "@sh_helm_helm_v3//pkg/action",
        "@sh_helm_helm_v3//pkg/chart",
        "@sh_helm_helm_v3//pkg/chart/loader",
        "@sh_helm_helm_v3//pkg/chartutil",
        "@sh_helm_helm_v3//pkg/kube/fake",
        "@sh_helm_helm_v3//pkg/registry",
        "@sh_helm_helm_v3//pkg/release",
        "@sh_helm_helm_v3//pkg/releaseutil",
        "@sh_helm_helm_v3//pkg/storage",
        "@sh_helm_helm_v3//pkg/storage/driver",
    ],
)

load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "e2e_lib",
    srcs = ["main.go"],
    importpath = "github.com/NVIDIA/dcgm-exporter/cmd/e2e",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/e2e/cli",
        "//internal/e2e/clioutput",
        "//internal/e2e/exec",
    ],
)

go_binary(
    name = "e2e",
    out = "e2e",
    embed = [":e2e_lib"],
    pure = "on",
    static = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "e2e_test",
    srcs = ["main_test.go"],
    embed = [":e2e_lib"],
    deps = [
        "//internal/e2e/scenario",
        "//internal/pkg/testutils/childcover",
    ],
)

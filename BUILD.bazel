load("@gazelle//:def.bzl", "gazelle")

exports_files([
    "LICENSE",
    "THIRD_PARTY_NOTICES",
    "docker/dcgm-exporter-entrypoint.sh",
    "etc/1.x-compatibility-metrics.csv",
    "etc/config.yaml",
    "etc/dcp-metrics-included.csv",
    "etc/default-counters.csv",
])

# gazelle:prefix github.com/NVIDIA/dcgm-exporter
# gazelle:build_tags container,k8s,dcgm_uri_integration
gazelle(name = "gazelle")

filegroup(
    name = "container_testdata",
    srcs = glob([
        "etc/**",
    ]) + ["//hack:versions.env"],
    visibility = ["//tests/container:__pkg__"],
)

filegroup(
    name = "counter_contract_data",
    srcs = glob([
        "etc/**",
    ]),
    visibility = ["//internal/pkg/counters:__pkg__"],
)

filegroup(
    name = "e2e_cli_testdata",
    srcs = ["Taskfile.yml"],
    visibility = ["//internal/e2e/cli:__pkg__"],
)

filegroup(
    name = "go_module_files",
    srcs = [
        "go.mod",
        "go.sum",
    ],
    visibility = ["//tests/static:__pkg__"],
)

filegroup(
    name = "k8s_testdata",
    srcs = [
        "//deployment:source_files",
        "etc/default-counters.csv",
    ],
    visibility = ["//tests/k8s:__pkg__"],
)

filegroup(
    name = "static_testdata",
    srcs = glob([
        "docker/**",
        "etc/**",
        "grafana/**",
    ]) + [
        "CONTRIBUTING.md",
        "README.md",
        "//deployment:source_files",
        "//hack:e2e-local-node.Dockerfile",
        "//packaging:config-files/systemd/nvidia-dcgm-exporter.service",
        "//tests/container:README.md",
        "//tests/k8s:README.md",
    ],
    visibility = ["//tests/static:__pkg__"],
)

# Version control
.git
.gitignore

# Build artifacts
dist/*
!dist/staged/
!dist/staged/**
*.tar.gz
!dist/staged/**/*.tar.gz
*.zip
bin/
cmd/dcgm-exporter/dcgm-exporter

# Bazel's private override is host-only.
.workspace/

# Local Bazel/Codex state is never a container input.
.cache/
.codex/
.cursor/

# Test files
tests/
tests.cov
*.test

# Documentation
README.md
CONTRIBUTING.md
RELEASE.md
SECURITY.md
*.md

# CI/CD and deployment
.github/
deployment/
examples/
grafana/

# Docker files - allow Dockerfiles and the runtime entrypoint
.dockerignore
!docker/Dockerfile
!docker/package-validation.Dockerfile
!docker/dcgm-exporter-entrypoint.sh

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
tmp/
*.tmp
*.log

# OS files
.DS_Store
Thumbs.db

# Local configuration
.env
.env.*
*.local

# Static analysis
staticcheck.conf
lint/

# Package sources are already inside the Bazel-owned staged tar.
packaging/*

# Product compilation is a Bazel action. The runtime Dockerfile consumes only
# its staged outputs, so source changes do not expand the Docker build context.
build/
cmd/
internal/
pkg/
go.mod
go.sum
hack/*
!hack/mise-bootstrap.env
!hack/task/
!hack/task/**
!hack/versions.env
!hack/licenses/
hack/licenses/*
!hack/licenses/stage-container-runtime.sh

# Scripts that aren't needed in build
scripts/
# The devcontainer build reads Bazel and version pins from hack/.

# Service definitions
*.yaml
*.yml
!Taskfile.yml

# Coverage reports
coverage.out
coverage.html

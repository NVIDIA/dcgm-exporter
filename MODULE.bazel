module(name = "dcgm_exporter")

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

# sync:go-dcgm-bazel-module:start
bazel_dep(
    name = "go_dcgm",
    version = "1.4712.2",
    repo_name = "com_github_nvidia_go_dcgm",
)

git_override(
    module_name = "go_dcgm",
    commit = "bc5d307bece3d373de882978c8503a1c8613e232",
    remote = "https://github.com/NVIDIA/go-dcgm.git",
)

# sync:go-dcgm-bazel-module:end
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_python", version = "2.4.6")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.1.0")

# rules_pkg uses a hermetic Python interpreter to create archives. Some of our
# container-based validation jobs intentionally run Bazel as root, so opt into
# rules_python's documented root-container mode for that interpreter.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    ignore_root_user_error = True,
    python_version = "3.14",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

ZIG_BUILD_FILE = """
package(default_visibility = ["//visibility:public"])

exports_files(["zig"])

filegroup(
    name = "files",
    srcs = glob(["**"]),
)
"""

# DCGM Exporter needs a pinned C toolchain because go-dcgm and go-nvml use
# CGO. Zig provides reproducible amd64 and arm64 outputs with an explicit glibc
# compatibility limit on either runner architecture. See build/toolchains/README.md.
# sync:zig-toolchain:start
http_archive(
    name = "zig_linux_amd64",
    build_file_content = ZIG_BUILD_FILE,
    sha256 = "3581863e3cbcfd0fce0efc682ce7e9e93da96668a977791d356a26d2a7e9b17a",
    strip_prefix = "zig-x86_64-linux-0.17.1",
    urls = ["https://ziglang.org/download/0.17.1/zig-x86_64-linux-0.17.1.tar.xz"],
)

http_archive(
    name = "zig_linux_arm64",
    build_file_content = ZIG_BUILD_FILE,
    sha256 = "a1546d5646eb184437918d6635ca6b762a0e889eac09cef720ee7a1ed3fe7795",
    strip_prefix = "zig-aarch64-linux-0.17.1",
    urls = ["https://ziglang.org/download/0.17.1/zig-aarch64-linux-0.17.1.tar.xz"],
)
# sync:zig-toolchain:end

register_toolchains(
    "//build/toolchains:linux_amd64_toolchain",
    "//build/toolchains:linux_amd64_toolchain_arm64_exec",
    "//build/toolchains:linux_arm64_cross_toolchain",
    "//build/toolchains:linux_arm64_toolchain_arm64_exec",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    # sync:go-sdk-download:start
    sdks = {
        "linux_amd64": [
            "go1.27.3.linux-amd64.tar.gz",
            "65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40",
        ],
        "linux_arm64": [
            "go1.27.3.linux-arm64.tar.gz",
            "a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49",
        ],
    },
    version = "1.27.3",
    # sync:go-sdk-download:end
)
use_repo(go_sdk, "main___download_0_linux_amd64", "main___download_0_linux_arm64")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
use_repo(go_deps, "io_opentelemetry_go_proto_otlp", "org_golang_google_protobuf")

go_deps.from_file(go_mod = "//:go.mod")

# kyaml embeds schemas across Go packages, which Gazelle omits at Bazel package boundaries.
go_deps.module_override(
    patch_strip = 1,
    patches = ["//build/patches:kyaml-openapi-embeds.patch"],
    path = "sigs.k8s.io/kustomize/kyaml",
)
use_repo(go_deps, "com_github_avast_retry_go_v4", "com_github_bits_and_blooms_bitset", "com_github_containerd_cgroups_v3", "com_github_distribution_reference", "com_github_fsnotify_fsnotify", "com_github_google_uuid", "com_github_gorilla_mux", "com_github_mittwald_go_helm_client", "com_github_nvidia_go_nvml", "com_github_onsi_ginkgo_v2", "com_github_onsi_gomega", "com_github_prometheus_client_golang", "com_github_prometheus_client_model", "com_github_prometheus_common", "com_github_prometheus_exporter_toolkit", "com_github_stretchr_testify", "com_github_urfave_cli_v2", "in_gopkg_yaml_v3", "io_k8s_api", "io_k8s_apimachinery", "io_k8s_client_go", "io_k8s_kubelet", "io_k8s_sigs_yaml", "io_k8s_utils", "io_opentelemetry_go_otel", "org_golang_google_grpc", "org_golang_x_sys", "org_uber_go_goleak", "org_uber_go_mock", "sh_helm_helm_v3", "sh_helm_helm_v4")
